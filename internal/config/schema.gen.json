{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "is a single step in a pipeline, corresponding to a CLI subcommand.",
      "examples": [
        {
          "action": "example",
          "all": true,
          "constructors": true,
          "emit_ir": true,
          "examples": true,
          "exclude": [
            "example"
          ],
          "fail_on_test": true,
          "implement": [
            {
              "discriminator_method": "example",
              "union": "example"
            }
          ],
          "out": "example",
          "package": "example",
          "packages": [
            "example"
          ],
          "path": "example",
          "rename": {
            "key1": "example"
          },
          "schema": "example",
          "spec": "example",
          "tags": [
            "example"
          ],
          "test": true,
          "validate": true
        }
      ],
      "properties": {
        "action": {
          "description": "CLI subcommand to run,enum=extract,enum=import,enum=generate,enum=diff",
          "type": "string"
        },
        "all": {
          "description": "Analyze all exported types (not just annotated)",
          "type": "boolean"
        },
        "constructors": {
          "description": "Generate NewT constructors for struct types",
          "type": "boolean"
        },
        "emit_ir": {
          "description": "Write IR YAML alongside generated output",
          "type": "boolean"
        },
        "examples": {
          "description": "Add generated examples to JSON Schema output",
          "type": "boolean"
        },
        "exclude": {
          "description": "Glob patterns for type names to skip",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fail_on_test": {
          "description": "Exit with error if any generated test fails (requires test: true)",
          "type": "boolean"
        },
        "implement": {
          "description": "Accessor methods to generate on union variants",
          "items": {
            "$ref": "#/$defs/ImplementRule"
          },
          "type": "array"
        },
        "out": {
          "description": "Output file or directory path",
          "type": "string"
        },
        "package": {
          "description": "Go package name for generated code",
          "type": "string"
        },
        "packages": {
          "description": "Go package patterns to analyze",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "description": "API path prefix to extract (e.g. /responses)",
          "type": "string"
        },
        "rename": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Type rename map: SchemaName → GoName",
          "type": "object"
        },
        "schema": {
          "description": "Path to the JSON Schema file",
          "type": "string"
        },
        "spec": {
          "description": "Path to the OpenAPI spec file",
          "type": "string"
        },
        "tags": {
          "description": "Additional struct tags to emit (e.g. yaml)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "test": {
          "description": "Run generated tests after code generation",
          "type": "boolean"
        },
        "validate": {
          "description": "Validate generated schema against meta-schema",
          "type": "boolean"
        }
      },
      "required": [
        "action"
      ],
      "title": "Action",
      "type": "object"
    },
    "File": {
      "additionalProperties": false,
      "description": "is the top-level config file structure.",
      "examples": [
        {
          "pipelines": {
            "key1": [
              {
                "action": "example",
                "all": true,
                "constructors": true,
                "emit_ir": true,
                "examples": true,
                "exclude": [
                  "example"
                ],
                "fail_on_test": true,
                "implement": [
                  {
                    "discriminator_method": "example",
                    "union": "example"
                  }
                ],
                "out": "example",
                "package": "example",
                "packages": [
                  "example"
                ],
                "path": "example",
                "rename": {
                  "key1": "example"
                },
                "schema": "example",
                "spec": "example",
                "tags": [
                  "example"
                ],
                "test": true,
                "validate": true
              }
            ]
          }
        }
      ],
      "properties": {
        "pipelines": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Action"
            },
            "type": "array"
          },
          "description": "Named pipelines. Each pipeline is a list of actions.",
          "type": "object"
        }
      },
      "required": [
        "pipelines"
      ],
      "title": "File",
      "type": "object"
    },
    "ImplementRule": {
      "additionalProperties": false,
      "description": "configures accessor method generation on union variants.",
      "examples": [
        {
          "discriminator_method": "example",
          "union": "example"
        }
      ],
      "properties": {
        "discriminator_method": {
          "description": "Method name for discriminator accessor (default: DiscriminatorValue)",
          "type": "string"
        },
        "union": {
          "description": "Union type name (schema or Go name)",
          "type": "string"
        }
      },
      "required": [
        "union"
      ],
      "title": "ImplementRule",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}