{
  "$defs": {
    "Circle": {
      "additionalProperties": false,
      "description": "is a round shape.",
      "properties": {
        "radius": {
          "minimum": 0,
          "type": "number"
        },
        "type": {
          "const": "circle",
          "type": "string"
        }
      },
      "required": [
        "type",
        "radius"
      ],
      "title": "Circle",
      "type": "object"
    },
    "LineItem": {
      "additionalProperties": false,
      "description": "is a single item in an order.",
      "properties": {
        "qty": {
          "minimum": 1,
          "type": "integer"
        },
        "sku": {
          "pattern": "^[A-Z]{3}-[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "sku",
        "qty"
      ],
      "title": "LineItem",
      "type": "object"
    },
    "Order": {
      "additionalProperties": false,
      "description": "represents a customer order.",
      "properties": {
        "id": {
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/LineItem"
          },
          "minItems": 1,
          "type": "array"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "is an enum of valid order states.",
          "enum": [
            "pending",
            "confirmed",
            "shipped"
          ],
          "title": "OrderStatus",
          "type": "string"
        }
      },
      "required": [
        "id",
        "items",
        "status"
      ],
      "title": "Order",
      "type": "object"
    },
    "Rectangle": {
      "additionalProperties": false,
      "description": "has four sides.",
      "properties": {
        "height": {
          "minimum": 0,
          "type": "number"
        },
        "type": {
          "const": "rectangle",
          "type": "string"
        },
        "width": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "type",
        "width",
        "height"
      ],
      "title": "Rectangle",
      "type": "object"
    },
    "Shape": {
      "description": "is a sealed union of shape types.",
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Circle"
        },
        {
          "$ref": "#/$defs/Rectangle"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}